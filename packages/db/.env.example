# Neon: DATABASE_URL is the pooled address (host ends in -pooler), for the app.
# DATABASE_URL_UNPOOLED is the direct address (no -pooler), for migrations and the seed.
# Use sslmode=verify-full with node-postgres.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Or a local Postgres for development:
# DATABASE_URL=postgresql://localhost:5432/prathamesh_dev

# The first Super Admin, created by db:seed. They sign in to the admin with this Google account.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=

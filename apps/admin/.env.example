# The database: Neon's pooled address (host ends in -pooler), with sslmode=verify-full.
# A local Postgres works for development: postgresql://localhost:5432/prathamesh_dev
DATABASE_URL=

# Better Auth. Make the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010

# Google sign-in for staff (Google Cloud console, OAuth client for a web application).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to the company's Google Workspace domain to allow only those accounts.
GOOGLE_WORKSPACE_DOMAIN=

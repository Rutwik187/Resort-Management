{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // next.config.ts also reads .env.local at the repo root.
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/.env*"],
      // The pages read every resort's catalogue while they prerender; search reads the database live.
      "env": ["DATABASE_URL", "ADMIN_URL", "META_PIXEL_ID", "META_CAPI_TOKEN", "GROUP_SITE_URL", "VERCEL_ENV"]
    },
    "dev": {
      "passThroughEnv": ["DATABASE_URL", "REVALIDATE_SECRET", "ADMIN_URL", "META_PIXEL_ID", "META_CAPI_TOKEN", "GROUP_SITE_URL", "VERCEL_ENV"]
    }
  }
}

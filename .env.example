# Settings for local development, read by every app and script in this repo.
# Copy this file to .env.local (git ignores it) and fill it in. Never commit
# real values. On Vercel, set the same names in each project's settings.

# ── Database: Neon Postgres ───────────────────────────────────────────
# Project withered-fire-71704216, branch production, Singapore.
# The pooled address (its host ends in -pooler), for the apps' queries.
DATABASE_URL=
# The direct address (no -pooler), for migrations and the seed.
DATABASE_URL_UNPOOLED=
# Use sslmode=verify-full in both. For a database on this machine instead:
# DATABASE_URL=postgresql://localhost:5432/prathamesh_dev

# ── Staff sign-in: Better Auth, in the admin app ──────────────────────
# Make the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010
# Google Cloud console > OAuth client for a web application.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to the company's Google Workspace domain to allow only its accounts.
GOOGLE_WORKSPACE_DOMAIN=

# ── Websites: rooms, rates and packages from the admin ───────────────
# The four resort sites read their catalogue from the database above and
# keep it cached; the admin asks a site to refresh when staff change it.
# The secret the admin and the sites share. Make it with: openssl rand -base64 32
REVALIDATE_SECRET=
# Where each site runs, for the admin to reach it (on Vercel, the sites' addresses).
WEBSITE_URLS=KS=http://localhost:3000,GC=http://localhost:3001,SB=http://localhost:3002,PV=http://localhost:3003

# ── Blog, FAQs and policies: Sanity ───────────────────────────────────
# Project ipifz5ts, dataset production (packages/sanity/src/config.ts). The
# sites read published content without a token. Sanity's webhook calls the
# admin's /api/sanity, signed with this secret; the admin then asks the
# resort's site to refresh. Make it with: openssl rand -base64 32
SANITY_WEBHOOK_SECRET=

# ── Payments: Razorpay ────────────────────────────────────────────────
# Each company enters its own keys in the admin (Settings > Payments); they
# are stored encrypted with PAYMENT_KEYS_SECRET. A resort with no keys of
# its own uses the account below, in test mode, so keep test keys here.
# The admin and all four sites need these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay's dashboard > Webhooks, for <admin>/api/webhooks/razorpay/<CODE>.
RAZORPAY_WEBHOOK_SECRET=
# Make it with: openssl rand -base64 32. Never change it once keys are saved.
PAYMENT_KEYS_SECRET=

# ── Seed: packages/db, pnpm db:seed ───────────────────────────────────
# The first Super Admin. They sign in with this Google account.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=

# ── Tests: packages/engine, pnpm test ─────────────────────────────────
# Where tests may create and drop their own databases. Defaults to the local Postgres.
# TEST_DATABASE_ADMIN_URL=postgresql://localhost:5432/postgres

# ── Object storage: Neon ──────────────────────────────────────────────
# Not set up yet. `neon env pull` adds these once the project is linked.
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

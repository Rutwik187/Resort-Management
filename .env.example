# Settings for local development, read by every app and script in this repo.
# Copy this file to .env.local (git ignores it) and fill it in. Never commit
# real values. On Vercel, set the same names in each project's settings.

# ── Database: Neon Postgres ───────────────────────────────────────────
# Project withered-fire-71704216, branch production, Singapore.
# The pooled address (its host ends in -pooler), for the apps' queries.
DATABASE_URL=
# The direct address (no -pooler), for migrations and the seed.
DATABASE_URL_UNPOOLED=
# Use sslmode=verify-full in both. For a database on this machine instead:
# DATABASE_URL=postgresql://localhost:5432/prathamesh_dev

# ── Staff sign-in: Better Auth, in the admin app ──────────────────────
# Make the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010
# Google Cloud console > OAuth client for a web application.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to the company's Google Workspace domain to allow only its accounts.
GOOGLE_WORKSPACE_DOMAIN=

# ── Websites: rooms, rates and packages from the admin ───────────────
# The four resort sites read their catalogue from the database above and
# keep it cached; the admin asks a site to refresh when staff change it.
# The secret the admin and the sites share. Make it with: openssl rand -base64 32
REVALIDATE_SECRET=
# Where each site runs, for the admin to reach it (on Vercel, the sites' addresses).
WEBSITE_URLS=KS=http://localhost:3000,GC=http://localhost:3001,SB=http://localhost:3002,PV=http://localhost:3003

# ── Blog, FAQs and policies: Sanity ───────────────────────────────────
# Project ipifz5ts, dataset production (packages/sanity/src/config.ts). The
# sites read published content without a token. Sanity's webhook calls the
# admin's /api/sanity, signed with this secret; the admin then asks the
# resort's site to refresh. Make it with: openssl rand -base64 32
SANITY_WEBHOOK_SECRET=

# ── Payments: Razorpay ────────────────────────────────────────────────
# Each company enters its own keys in the admin (Settings > Payments); they
# are stored encrypted with PAYMENT_KEYS_SECRET. A resort with no keys of
# its own uses the account below, in test mode, so keep test keys here.
# The admin and all four sites need these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay's dashboard > Webhooks, for <admin>/api/webhooks/razorpay/<CODE>.
RAZORPAY_WEBHOOK_SECRET=
# Make it with: openssl rand -base64 32. Never change it once keys are saved.
PAYMENT_KEYS_SECRET=

# ── Email: Resend ─────────────────────────────────────────────────────
# Booking confirmations, refunds and booking links wait in the outbox until
# both are set. The address must be on a domain verified in Resend. Each
# resort's name is the sender's name; replies go to its email in Settings.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# ── Jobs ──────────────────────────────────────────────────────────────
# Vercel Cron sends it to the admin's /api/cron. Make it with: openssl rand -base64 32
CRON_SECRET=

# ── Seed: packages/db, pnpm db:seed ───────────────────────────────────
# The first Super Admin. They sign in with this Google account.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=

# ── Tests: packages/engine, pnpm test ─────────────────────────────────
# Where tests may create and drop their own databases. Defaults to the local Postgres.
# TEST_DATABASE_ADMIN_URL=postgresql://localhost:5432/postgres


# ── Leads (CRM) ───────────────────────────────────────────────────────
# The admin's address, for links in lead alerts and reminders sent from the sites.
# ADMIN_URL=https://prathamesh-admin.vercel.app
# Meta lead ads webhook at /api/webhooks/meta-leads on the admin (URD 7.5).
# META_VERIFY_TOKEN=
# META_APP_SECRET=
# META_PAGE_TOKEN=
# Which resort and kind of lead each lead form is for, such as {"1234567890":"KS:wedding","default":"KS:wedding"}
# META_LEAD_FORMS=

# ── Tracking (each site's own Vercel project) ─────────────────────────
# Google Tag Manager carries GA4 and Google Ads; the Meta Pixel loads only with marketing consent.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=

# ── Email delivery reports ────────────────────────────────────────────
# The signing secret of Resend's webhook pointed at /api/webhooks/resend on the admin (NOT-05).
# RESEND_WEBHOOK_SECRET=whsec_...

# ── Google reviews and redirects (admin) ──────────────────────────────
# Places API (New) key, for each resort's rating, count and reviews (REV-01). Set each place id on the Website page.
# GOOGLE_PLACES_API_KEY=
# Vercel deploy hooks, so a new redirect rebuilds that site: {"KS":"https://api.vercel.com/v1/integrations/deploy/...","GC":"..."}
# DEPLOY_HOOKS=

# ── Meta Conversions API (each site's Vercel project) ─────────────────
# Server-side Purchase and Lead events, matched to the Pixel's by event id (TRK-02).
# META_PIXEL_ID=
# META_CAPI_TOKEN=

# ── Group site (apps/group) ───────────────────────────────────────────
# Its address once the client picks the group domain. Search engines see it only in production with this set.
# GROUP_SITE_URL=https://prathameshgroup.com
# Add GROUP=<its address> to the admin's WEBSITE_URLS so it refreshes when any resort changes.

# ── File storage: Vercel Blob (admin) ─────────────────────────────────
# Public store, for gallery and page photos on the websites. Vercel names its token this when the store is connected.
# BLOB_READ_WRITE_TOKEN=
# Private store, for guests' ID proofs (ADM-08). Connect a private store and rename its token to this.
# BLOB_PRIVATE_READ_WRITE_TOKEN=
